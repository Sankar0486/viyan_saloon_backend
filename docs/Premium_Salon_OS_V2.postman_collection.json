    },
    {
      "name": "Tenant isolation checks (use matching role tokens)",
      "item": [
        {
          "name": "Company Admin: create salon in own company",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer COMPANY_ADMIN_ACCESS_TOKEN"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/salons",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Company Admin Salon\",\n  \"code\": \"COMPANY-ADMIN-SALON\",\n  \"address\": \"Company branch\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Company Admin: access another company's salon (expect 404)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer COMPANY_ADMIN_ACCESS_TOKEN"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/salons/OTHER_COMPANY_SALON_UUID",
            "body": {
              "mode": "raw",
              "raw": "false",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Salon Owner: create staff in another salon (expect 403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer SALON_OWNER_ACCESS_TOKEN"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users/staff",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"salonId\": \"OTHER_SALON_UUID\",\n  \"name\": \"Blocked Staff\",\n  \"email\": \"blocked.staff@example.com\",\n  \"password\": \"BlockedStaff123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
