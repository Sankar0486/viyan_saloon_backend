              }
            ],
            "url": "{{baseUrl}}/users/salon-owners",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"salonId\": \"{{salonId}}\",\n  \"name\": \"Salon Owner\",\n  \"email\": \"{{salonOwnerEmail}}\",\n  \"phone\": \"+919876543212\",\n  \"password\": \"SalonOwner123!\"\n}",
