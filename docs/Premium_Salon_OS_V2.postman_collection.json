              "raw": "{\n  \"salonId\": \"{{salonId}}\",\n  \"name\": \"Salon Manager\",\n  \"email\": \"manager@example.com\",\n  \"phone\": \"+919876543213\",\n  \"password\": \"SalonManager123!\"\n}",
              "options": {
